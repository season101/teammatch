{
  "$description": "TeamMatch design tokens. Source of truth for every colour, type, space, shape and motion value. Format follows the W3C Design Tokens Community Group draft. frontend/src/app/globals.css must match these values; change both in the same pull request.",
  "color": {
    "dark": {
      "$description": "Default theme.",
      "bg": { "$type": "color", "$value": "#0B0A10", "$description": "Stage behind everything." },
      "surface": { "$type": "color", "$value": "#15131D", "$description": "Panels, sidebar, cards." },
      "surface-2": { "$type": "color", "$value": "#1F1C2A", "$description": "Inputs, rows, unmatched chips." },
      "border": { "$type": "color", "$value": "#2C2839" },
      "text": { "$type": "color", "$value": "#F6F4FB" },
      "text-muted": { "$type": "color", "$value": "#A7A2B8" },
      "primary": { "$type": "color", "$value": "#7C5CFF", "$description": "Indicators only: focus ring, active tab, selection border." },
      "primary-strong": { "$type": "color", "$value": "#6A47FF", "$description": "Violet fills that carry white text." },
      "on-primary": { "$type": "color", "$value": "#FFFFFF" },
      "apply": { "$type": "color", "$value": "#C6F432", "$description": "Yes, apply, filled. Fills only." },
      "on-apply": { "$type": "color", "$value": "#0B0A10" },
      "apply-text": { "$type": "color", "$value": "#C6F432", "$description": "Lime used as text, lines and meters." },
      "pass": { "$type": "color", "$value": "#FF5C70", "$description": "Pass, errors, destructive text. Alias: danger." },
      "on-danger": { "$type": "color", "$value": "#0B0A10" },
      "info": { "$type": "color", "$value": "#3CC8FF" },
      "undo": { "$type": "color", "$value": "#FFC53D", "$description": "Undo and warnings. Alias: warning." },
      "success": { "$type": "color", "$value": "#34D399" },
      "cta": { "$type": "color", "$value": "#FFFFFF", "$description": "Primary button fill." },
      "on-cta": { "$type": "color", "$value": "#0B0A10" },
      "scrim": { "$type": "color", "$value": "rgb(11 10 16 / 0.7)", "$description": "Behind modals." }
    },
    "light": {
      "bg": { "$type": "color", "$value": "#F8F7FB" },
      "surface": { "$type": "color", "$value": "#FFFFFF" },
      "surface-2": { "$type": "color", "$value": "#F1EFF6" },
      "border": { "$type": "color", "$value": "#E3E0EB" },
      "text": { "$type": "color", "$value": "#15131D" },
      "text-muted": { "$type": "color", "$value": "#5E5872" },
      "primary": { "$type": "color", "$value": "#6A47FF" },
      "primary-strong": { "$type": "color", "$value": "#6A47FF" },
      "on-primary": { "$type": "color", "$value": "#FFFFFF" },
      "apply": { "$type": "color", "$value": "#C6F432" },
      "on-apply": { "$type": "color", "$value": "#0B0A10" },
      "apply-text": { "$type": "color", "$value": "#3F6600" },
      "pass": { "$type": "color", "$value": "#C42339" },
      "on-danger": { "$type": "color", "$value": "#FFFFFF" },
      "info": { "$type": "color", "$value": "#0870A6" },
      "undo": { "$type": "color", "$value": "#8A6406" },
      "success": { "$type": "color", "$value": "#0B7A54" },
      "cta": { "$type": "color", "$value": "#15131D" },
      "on-cta": { "$type": "color", "$value": "#FFFFFF" },
      "scrim": { "$type": "color", "$value": "rgb(21 19 29 / 0.5)" }
    },
    "spark": {
      "$type": "gradient",
      "$value": [
        { "color": "#7C5CFF", "position": 0 },
        { "color": "#FF4FD8", "position": 1 }
      ],
      "$description": "135deg. Logo and celebrations only. Same in both themes."
    },
    "cover": {
      "$description": "Project cover colours. Content, not theme: same in both themes. White text is at least 4.5:1 on each.",
      "raspberry": { "$type": "color", "$value": "#C2275B" },
      "pine": { "$type": "color", "$value": "#0B5E57" },
      "cobalt": { "$type": "color", "$value": "#2058C9" },
      "indigo": { "$type": "color", "$value": "#3E2BB8" },
      "plum": { "$type": "color", "$value": "#7A2E58" },
      "rust": { "$type": "color", "$value": "#9A3412" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Fraunces", "ui-serif", "Georgia", "serif"] },
      "ui": { "$type": "fontFamily", "$value": ["Geist", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["Geist Mono", "ui-monospace", "monospace"] }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "14px" },
      "base": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "18px" },
      "xl": { "$type": "dimension", "$value": "20px" },
      "2xl": { "$type": "dimension", "$value": "24px" },
      "3xl": { "$type": "dimension", "$value": "32px" },
      "4xl": { "$type": "dimension", "$value": "44px" },
      "5xl": { "$type": "dimension", "$value": "64px" },
      "hero": { "$type": "dimension", "$value": "clamp(44px, 8vw, 96px)" }
    },
    "line-height": {
      "display": { "$type": "number", "$value": 1.1 },
      "body": { "$type": "number", "$value": 1.5 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "chip": { "$type": "dimension", "$value": "6px" },
    "input": { "$type": "dimension", "$value": "10px" },
    "row": { "$type": "dimension", "$value": "14px" },
    "card": { "$type": "dimension", "$value": "20px" },
    "sheet": { "$type": "dimension", "$value": "28px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "shadow": {
    "card-dark": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "18px", "blur": "40px", "spread": "-12px", "color": "rgb(0 0 0 / 0.6)" } },
    "card-light": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "-12px", "color": "rgb(21 19 29 / 0.18)" } },
    "modal": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "24px", "blur": "64px", "spread": "0px", "color": "rgb(0 0 0 / 0.7)" } }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "320ms" },
      "stagger": { "$type": "duration", "$value": "80ms", "$description": "Gap between items that enter in sequence: splash seats, It's a Team! avatars." },
      "splash-hold": { "$type": "duration", "$value": "700ms", "$description": "How long the landing splash stays before it lifts away." }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] }
    },
    "swipe": {
      "$description": "Swipe deck physics.",
      "tilt-divisor": { "$type": "number", "$value": 20, "$description": "Tilt in degrees = drag distance in px / 20." },
      "tilt-max": { "$type": "number", "$value": 15, "$description": "Degrees." },
      "commit-ratio": { "$type": "number", "$value": 0.3, "$description": "Share of card width that commits a swipe." },
      "fling-velocity": { "$type": "number", "$value": 0.6, "$description": "px per ms that commits a swipe." }
    }
  },
  "size": {
    "touch-min": { "$type": "dimension", "$value": "44px" },
    "action-large": { "$type": "dimension", "$value": "64px" },
    "action-small": { "$type": "dimension", "$value": "48px" },
    "sidebar": { "$type": "dimension", "$value": "320px" },
    "panel-right": { "$type": "dimension", "$value": "400px" },
    "card-desktop-width": { "$type": "dimension", "$value": "380px" },
    "card-desktop-height": { "$type": "dimension", "$value": "640px" }
  },
  "breakpoint": {
    "tablet": { "$type": "dimension", "$value": "640px" },
    "desktop": { "$type": "dimension", "$value": "1024px" },
    "wide": { "$type": "dimension", "$value": "1440px" }
  }
}
