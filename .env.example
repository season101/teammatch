# Local development settings. Copy to .env (make setup) and change the passwords.

# postgres
POSTGRES_DB=teammatch
POSTGRES_USER=teammatch
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

# redis
REDIS_PORT=6379

# object storage (SeaweedFS, S3 API)
S3_ACCESS_KEY=teammatch-local
S3_SECRET_KEY=change-me-local-secret
S3_BUCKET=teammatch-media
S3_PORT=8333

# django
DJANGO_SECRET_KEY=change-me-local-django
DJANGO_DEBUG=true
ALLOWED_EMAIL_DOMAINS=latech.edu

# google sign-in (optional locally)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
